{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.ts": { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "cache-control", "value": "no-store" },
        { "key": "x-content-type-options", "value": "nosniff" }
      ]
    }
  ]
}
