  <string-array name="phrases_greeting">
    <item>¡A encender el día!</item>
    <item>Hola, aquí sigo ardiendo.</item>
    <item>¿Damos unos pasos juntos?</item>
  </string-array>
  <string-array name="phrases_dim">
    <item>Me estoy apagando… ¿caminamos?</item>
    <item>Unos pasos y vuelvo a brillar.</item>
    <item>Llevo rato quieta. ¿Te mueves?</item>
    <item>Necesito un poco de leña.</item>
    <item>Un paseo corto me reaviva.</item>
  </string-array>
  <string-array name="phrases_restless">
    <item>Noto tensión. ¿Respiramos?</item>
    <item>Un minuto de aire nos calma.</item>
    <item>Vamos despacio, juntas.</item>
  </string-array>
  <string-array name="phrases_calm">
    <item>Vamos bien, sin prisa.</item>
    <item>Ardo a fuego lento.</item>
    <item>Un poco más y brillo de verdad.</item>
    <item>Buen ritmo. Sigamos.</item>
    <item>Me gusta este calorcito.</item>
  </string-array>
  <string-array name="phrases_happy">
    <item>¡Qué bien te mueves!</item>
    <item>¡Mírame brillar!</item>
    <item>Ya casi llegamos a la meta.</item>
    <item>Tus pasos me encienden.</item>
    <item>¡Esto es fuego del bueno!</item>
  </string-array>
  <string-array name="phrases_ecstatic">
    <item>¡Meta cumplida! ¡Ardo de alegría!</item>
    <item>¡Lo logramos! ¡Qué hoguera!</item>
    <item>¡Hoy somos leyenda!</item>
    <item>¡No me cabe tanto fuego!</item>
    <item>¡Récord de chispas!</item>
  </string-array>

