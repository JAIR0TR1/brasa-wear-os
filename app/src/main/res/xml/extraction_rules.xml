<?xml version="1.0" encoding="utf-8"?>
<!-- Copia de seguridad (Android 12+): docs "Back up user data with Auto Backup". -->
<data-extraction-rules>
  <cloud-backup>
      <!-- Solo ajustes y progreso (XP, respiraciones, meta). Pasos, pulso e id del reloj no salen. -->
      <include domain="file" path="datastore/brasa_respaldo.preferences_pb" />
      <!-- Idioma elegido en la app (AppCompat, Android 12 o inferior). -->
      <include domain="file" path="androidx.appcompat.app.AppCompatDelegate.application_locales_record_file" />
  </cloud-backup>
  <device-transfer>
      <!-- Solo ajustes y progreso (XP, respiraciones, meta). Pasos, pulso e id del reloj no salen. -->
      <include domain="file" path="datastore/brasa_respaldo.preferences_pb" />
      <!-- Idioma elegido en la app (AppCompat, Android 12 o inferior). -->
      <include domain="file" path="androidx.appcompat.app.AppCompatDelegate.application_locales_record_file" />
  </device-transfer>
</data-extraction-rules>
