<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-feature android:name="android.hardware.type.watch" />
  <!-- Vibraciones de ritmo (respiración) y de reacción. -->
  <uses-permission android:name="android.permission.VIBRATE" />

  <application
    android:allowBackup="true"
    android:icon="@drawable/ic_brasa"
    android:label="@string/app_name"
    android:supportsRtl="true"
    android:theme="@style/Theme.Brasa">

    <!-- App independiente: funciona sin teléfono (docs: Standalone versus non-standalone Wear OS apps). -->
    <meta-data
      android:name="com.google.android.wearable.standalone"
      android:value="true" />

    <!-- Idioma por app en Android 12 o inferior (docs: Per-app language preferences). -->
    <service
      android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
      android:enabled="false"
      android:exported="false">
      <meta-data
        android:name="autoStoreLocales"
        android:value="true" />
    </service>

    <activity
      android:name=".MainActivity"
      android:exported="true"
      android:taskAffinity=""
      android:theme="@style/Theme.Brasa.Arranque">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
